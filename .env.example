# Supabase — public values only (Project Settings → API / API Keys in the Supabase dashboard).
# The publishable (or legacy "anon") key is designed for browser use; Row Level Security still applies.
# NEVER put the service_role / secret key in any NEXT_PUBLIC_ variable. The dashboard does not need it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
